SERVER_PORT=8081
SPRING_SQL_INIT_MODE=never

MYSQL_URL=jdbc:mysql://devlog-db:3306/devlog?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_USERNAME=devlog_app
MYSQL_PASSWORD=change-me

LLM_MODE=gemini
LLM_MOCK_ALWAYS_FAIL=false
LLM_GEMINI_API_KEY=change-me
LLM_GEMINI_MODEL=gemini-2.5-flash
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
LLM_GEMINI_CONNECT_TIMEOUT_MS=3000
LLM_GEMINI_READ_TIMEOUT_MS=30000

DEVTALK_BASE_URL=http://devtalk-backend:8080
DEVTALK_CONNECT_TIMEOUT_MS=3000
DEVTALK_READ_TIMEOUT_MS=10000

CORS_ALLOWED_ORIGINS=https://devlog.example.com
