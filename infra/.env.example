COMPOSE_PROJECT_NAME=devlog

DEVLOG_FRONTEND_HOST_PORT=8081
DEVLOG_BACKEND_DEBUG_PORT=18081

MYSQL_DATABASE=devlog
MYSQL_USER=devlog_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

SERVER_PORT=8081
SPRING_SQL_INIT_MODE=never

MYSQL_URL=jdbc:mysql://devlog-db:3306/devlog?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_USERNAME=devlog_app

LLM_MODE=gemini
LLM_MOCK_ALWAYS_FAIL=false
LLM_GEMINI_API_KEY=change-me
LLM_GEMINI_MODEL=gemini-2.5-flash
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
LLM_GEMINI_CONNECT_TIMEOUT_MS=3000
LLM_GEMINI_READ_TIMEOUT_MS=30000
LLM_DEFAULT_TEMPERATURE=0.2
LLM_DEFAULT_MAX_TOKENS=65536

DEVTALK_BASE_URL=http://devtalk-backend:8080
DEVTALK_CONNECT_TIMEOUT_MS=3000
DEVTALK_READ_TIMEOUT_MS=10000

SYNC_MAX_PAGES=1000
DRAFT_MAX_SELECTED_BLOCKS=200
MCP_INGEST_MAX_BLOCKS=500
MCP_INGEST_MAX_MESSAGES_PER_BLOCK=200
MCP_EVENT_MAX_CONTENT_BYTES=65536

CORS_ALLOWED_ORIGINS=http://localhost:8081
VITE_API_BASE_URL=/devlog/api/devlog
